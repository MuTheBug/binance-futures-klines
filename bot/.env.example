# ===== ECHO Engine bot configuration =====
# Copy to `.env` (same folder) and fill in. NEVER commit your real .env.
# The bot starts SAFE: DRY_RUN=true and BINANCE_TESTNET=true until you change them.

# --- Exchange selector ---
# "binance" (default) or "bybit". The bot logic is identical on both venues.
EXCHANGE=binance

# --- Binance USDT-M Futures API keys ---
# Testnet keys: https://testnet.binancefuture.com   |  Mainnet: Binance > API Management
# Required permissions: "Enable Futures". DISABLE withdrawals. IP-whitelist if possible.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true            # true = testnet (fake money). Set false ONLY when ready.

# --- Bybit USDT-perp (linear) API keys --- (only used when EXCHANGE=bybit)
# Testnet: https://testnet.bybit.com  |  Mainnet: Bybit > API. Unified Trading Account,
# permission "Contract/Orders+Positions". DISABLE withdrawals. Keep account in One-way mode.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true              # true = testnet (fake money). Set false ONLY when ready.

# --- Telegram ---
# 1) Create a bot via @BotFather -> get the token. 2) Message your bot, then run the bot:
#    leave TG_CHAT_IDS empty on first run and it auto-learns your chat id (see /id).
TG_TOKEN=
TG_CHAT_IDS=                    # comma-separated authorized chat ids, e.g. 12345678

# --- Strategy / sizing ---
LEVERAGE=2.0                    # strategy leverage multiplier (research: 2x = growth-near-optimal)
TARGET_VOL=0.40                 # annualized vol target of the gross~1 blend
BLEND_ECHO=0.80          # weight on ECHO book; rest on RIFT momentum sleeve
BLEND_TREND=0.50               # 0.50 = 50% trend / 50% residual-continuation (the ECHO blend)
MAX_GROSS=3.0                  # hard cap on total |notional|/equity (safety)
MAX_POSITIONS=14               # keep only the strongest N target positions
BINANCE_LEVERAGE=5             # per-symbol leverage set on Binance (margin headroom, not exposure)

# --- Risk controls ---
DRY_RUN=true                   # true = compute & report orders but DO NOT send them
MAX_DRAWDOWN_STOP=0.45         # circuit breaker: flatten + pause if equity DD exceeds this
MIN_ORDER_USDT=5.0             # skip dust orders below this notional
REBALANCE_BAND=0.25            # no-churn band: only retrade a name if it drifts > 25% of its target

# --- Schedule (UTC) ---
REBALANCE_UTC_HOUR=0           # rebalance time, just after the 00:00 UTC daily close
REBALANCE_UTC_MINUTE=5
REBALANCE_EVERY_DAYS=2         # cadence in days; stress-tests show 2-3d slightly beats daily
SUMMARY_UTC_HOUR=8             # daily check-in alert time (equity/positions snapshot)
POLL_SECONDS=10

# --- Paths (usually leave default) ---
# RESEARCH_DIR=/abs/path/to/repo/research
# STATE_PATH=/abs/path/to/bot/state.json

# Execution: "maker" tries post-only limits first (saves ~3-5bps/side), falls back to market
EXEC_STYLE=maker
MAKER_WAIT_S=45

# Soft profit-trailing throttle: halve the book past 25% drawdown, restore after recovery to 12.5% (0 = off)
TRAIL_DD=0.25
TRAIL_THROTTLE=0.5

# PF/win-rate levers (research/pf_push.py): drop weakest 30% of names; flatten dust days (scale MIN_GROSS with LEVERAGE)
CONVICTION_FLOOR=0.30
MIN_GROSS=1.3

# --- SMALL ACCOUNT PRESET (~$100 equity; research/micro100.py) ---
# Uncomment for tiny accounts: 14 positions is the measured optimum under
# Binance's $5 min order (NOT 8 -- diversification beats dust-skips), keep 2x.
# MAX_POSITIONS=14
# LEVERAGE=2.0
# MIN_GROSS=1.3
